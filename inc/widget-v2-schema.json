        "value": "plastic",
        "label": "Plastic"
      },
      {
        "value": "polaris",
        "label": "Polaris"
      },
      {
        "value": "polaris-electric",
        "label": "Polaris \u2014 Electric"
      },
      {
        "value": "polaris-admin-dark",
        "label": "Polaris \u2014 Admin dark (dark)"
      },
      {
        "value": "poster",
        "label": "Poster"
      },
      {
        "value": "poster-hazard",
