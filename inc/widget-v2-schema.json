  },
  {
    "type": "checkbox",
    "id": "filter_team",
    "label": "Team filter",
    "default": true
  },
  {
    "type": "checkbox",
    "id": "filter_member",
    "label": "Host filter",
    "default": true
  },
  {
    "type": "checkbox",
    "id": "filter_location",
    "label": "Location filter",
    "default": true
  },
  {
    "type": "checkbox",
    "id": "filter_language",
    "label": "Language filter",
    "default": true
  },
  {
    "type": "text",
    "id": "default_filter_team",
    "label": "Default team",
    "default": ""
  },
  {
    "type": "text",
    "id": "default_filter_member",
    "label": "Default host",
    "default": ""
  },
  {
    "type": "text",
    "id": "default_filter_category",
    "label": "Default category",
    "info": "Enter the name exactly as it appears in the Servv app. Which filters are shown is set there too."
  },
  {
    "type": "text",
    "id": "default_filter_location",
    "label": "Default location"
  },
  {
    "type": "text",
    "id": "default_filter_language",
    "label": "Default language"
  },
  {
    "type": "checkbox",
    "id": "default_filter_hide_others",
    "label": "Hide other choices for defaulted filters",
    "default": false
  },
  {
    "type": "header",
