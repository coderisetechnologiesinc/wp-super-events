  {
    "type": "checkbox",
    "id": "show_price",
    "label": "Price",
    "default": true
  },
  {
    "type": "checkbox",
    "id": "show_badges",
    "label": "Badges",
    "default": true
  },
  {
    "type": "range",
    "id": "card_description_words",
    "label": "Description word limit",
